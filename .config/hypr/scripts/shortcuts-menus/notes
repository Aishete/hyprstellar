#!/usr/bin/env bash

folder="$HOME/Documents/obsidian/orgfiles/note/"
: "${TERMINAL:=kitty}"

# Ensure notes directory exists
if [ ! -d "$folder" ]; then
  mkdir -p "$folder" || { echo "Error: Cannot create directory $folder"; exit 1; }
fi

newnote () {
  dir="$(command ls -d "$folder" "$folder"*/ 2>/dev/null | dmenu -c -l 5 -i -p 'Choose directory: ')" || return 1
  : "${dir:=$folder}"
  dir="${dir%/}"  # Remove trailing slash
  name="$(echo "" | rofi -dmenu -c -sb "#a3be8c" -nf "#d8dee9" -p "Enter a name: " <&-)" || return 1
  : "${name:=$(date +%F_%H-%M-%S)}"
  name="${name%.org}"  # Strip .md if provided
  if ! setsid -f "$TERMINAL" -e nvim "$dir/$name.org"; then
    echo "Error: Failed to open terminal or nvim"
    exit 1
  fi
}

selected () {
  choice=$(echo -e "New\n$(find "$folder" -type f -name "*.md" -printf '%T@ %P\n' | sort -nr | cut -d' ' -f2-)" | rofi -dmenu -c -l 5 -i -p "Choose note or create new: ") || exit 0
  case "$choice" in
    New) newnote ;;
    *.md) 
      if ! setsid -f "$TERMINAL" -e nvim "$folder$choice"; then
        echo "Error: Failed to open terminal or nvim"
        exit 1
      fi
      ;;
    *) exit 0 ;;
  esac
}

selected
